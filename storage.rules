rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profilbilder. Lesbar für jeden authentifizierten Nutzer (werden u. a.
    // in der Freundesliste, später in Gruppen/Chat/Matches angezeigt).
    // Hochladen/Ändern/Löschen ausschließlich durch den Owner selbst, mit
    // serverseitiger Größen- und Content-Type-Prüfung.
    match /profile_images/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
