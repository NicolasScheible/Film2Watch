rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Profilbilder. Lesbar für jeden authentifizierten Nutzer (werden u. a.
    // in der Freundesliste, später in Gruppen/Chat/Matches angezeigt).
    // Hochladen/Ändern/Löschen ausschließlich durch den Owner selbst, mit
    // serverseitiger Größen- und Content-Type-Prüfung.
    match /profile_images/{uid}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Gruppenbilder. Lesbar für jeden authentifizierten Nutzer.
    //
    // WICHTIG: Firebase Storage Security Rules können keine Firestore-Daten
    // lesen (kein exists()/get() auf Firestore-Dokumente) - "nur der
    // tatsächliche Admin der Gruppe X darf schreiben" ist mit reinen Storage
    // Rules technisch nicht durchsetzbar, ohne Firebase Auth Custom Claims
    // plus eine Cloud Function, die sie bei Rollenänderungen aktualisiert
    // (neue Infrastruktur, nicht Teil dieses Schritts). Schreiben/Löschen ist
    // daher wie beim Profilbild auf "authentifiziert" begrenzt; die
    // eigentliche Admin-Berechtigung wird dort durchgesetzt, wo es technisch
    // geht: groups/{groupId}.photo_url in Firestore ist nur vom Admin
    // änderbar, ein unautorisierter Storage-Upload würde also nie als
    // tatsächliches Gruppenbild in der App erscheinen.
    match /group_images/{groupId}/{fileName} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null;
    }
  }
}
