rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Deterministische, sortierte Paar-ID für eine Freundschaft zwischen
    // zwei Usern - unabhängig davon, wer die Anfrage gesendet hat.
    function pairId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function isGroupMember(groupId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function groupMemberRole(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role;
    }

    function isGroupAdmin(groupId) {
      return isGroupMember(groupId) && groupMemberRole(groupId) == 'admin';
    }

    // Privates Profil (u. a. E-Mail). Nur der Owner darf lesen/schreiben.
    // uid, email, friend_code und created_at dürfen nach dem Anlegen nie
    // mehr verändert werden (auch nicht vom Owner selbst).
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.friend_code == resource.data.friend_code
        && request.resource.data.created_at == resource.data.created_at;
      allow delete: if false;
    }

    // Freundescode-Eindeutigkeits-Lookup (code -> uid). Jeder authentifizierte
    // User darf prüfen, ob ein Code existiert, aber nur seinen eigenen Code
    // anlegen und niemals fremde Einträge verändern oder löschen.
    match /friend_codes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.uid;
      allow update, delete: if false;
    }

    // Öffentlich sichtbare Profil-Teilmenge (Name, Bild, Freundescode), damit
    // andere User per Freundescode suchen bzw. Freunde anzeigen können, ohne
    // Zugriff auf das private users/{uid}-Dokument zu benötigen. Kein `list`,
    // damit niemand alle Profile durchsuchen/scrapen kann - Zugriff nur per
    // bekannter uid (über den friend_codes-Lookup).
    match /public_profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.friend_code == resource.data.friend_code;
      allow delete: if false;
    }

    // Offene Freundschaftsanfragen. Dokument-ID ist deterministisch
    // "{fromUid}_{toUid}". Ein zweiter create-Versuch auf dieselbe ID wird
    // von Firestore als `update` behandelt, das hier nicht erlaubt ist -
    // doppelte Anfragen in dieselbe Richtung sind damit unmöglich. Bereits
    // bestehende Freundschaften blockieren neue Anfragen zusätzlich serverseitig.
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.fromUid
        && request.resource.data.fromUid != request.resource.data.toUid
        && requestId == request.resource.data.fromUid + '_' + request.resource.data.toUid
        && !exists(/databases/$(database)/documents/friendships/$(pairId(request.resource.data.fromUid, request.resource.data.toUid)));

      allow update: if false;

      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
    }

    // Bestätigte Freundschaften. Ein Dokument pro Paar (sortierte,
    // deterministische ID) statt zwei einzelner Einträge - dadurch ist die
    // Beziehung strukturell immer symmetrisch und kann nie einseitig
    // existieren. Eine Freundschaft darf ausschließlich als Ergebnis einer
    // Annahme einer echten, an einen selbst gerichteten Anfrage entstehen.
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;

      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.uids.size() == 2
        && friendshipId == pairId(request.resource.data.uids[0], request.resource.data.uids[1])
        && exists(/databases/$(database)/documents/friend_requests/$(
             request.resource.data.uids[0] == request.auth.uid
               ? request.resource.data.uids[1] + '_' + request.auth.uid
               : request.resource.data.uids[0] + '_' + request.auth.uid
           ));

      allow update: if false;

      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    // Gruppen. Nur Mitglieder dürfen lesen, nur Admins dürfen bearbeiten/
    // löschen. id/created_by/created_at sind nach dem Anlegen unveränderlich.
    match /groups/{groupId} {
      allow read: if isGroupMember(groupId);

      allow create: if isSignedIn() && request.auth.uid == request.resource.data.created_by;

      allow update: if isGroupAdmin(groupId)
        && request.resource.data.id == resource.data.id
        && request.resource.data.created_by == resource.data.created_by
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if isGroupAdmin(groupId);

      // Mitgliedschaft + Rolle. Dokument-ID ist die uid - verhindert
      // doppelte Mitgliedschaften strukturell.
      match /members/{memberUid} {
        allow read: if isGroupMember(groupId);

        // Erst-Mitgliedschaft: nur der tatsächliche Ersteller der Gruppe darf
        // sich selbst als Admin eintragen. Beitritt danach ausschließlich als
        // 'member' und ausschließlich mit einer echten, an einen selbst
        // gerichteten Einladung (siehe group_invitations unten).
        allow create: if isSignedIn() && request.auth.uid == memberUid && (
          (request.resource.data.role == 'admin'
            && get(/databases/$(database)/documents/groups/$(groupId)).data.created_by == request.auth.uid)
          ||
          (request.resource.data.role == 'member'
            && exists(/databases/$(database)/documents/group_invitations/$(groupId + '_' + request.auth.uid)))
        );

        // Rollenänderungen (z. B. Admin-Übertragung) nur durch den Admin.
        allow update: if isGroupAdmin(groupId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.joined_at == resource.data.joined_at;

        // Verlassen (eigene Mitgliedschaft) oder Entfernen durch den Admin.
        allow delete: if isSignedIn() && (request.auth.uid == memberUid || isGroupAdmin(groupId));
      }

      // Swipe-Entscheidungen (like/dislike) pro Mitglied und Film.
      // Dokument-ID ist deterministisch "{uid}_{movieId}" - ein erneutes
      // Bewerten desselben Films aktualisiert die bestehende Entscheidung
      // statt ein zweites Dokument zu erzeugen. Lesbar für alle Mitglieder
      // (spätere Match-Auswertung braucht das), schreibbar ausschließlich
      // für den eigenen Swipe. Kein Löschen in diesem Schritt.
      match /swipes/{swipeId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.auth.uid == request.resource.data.uid
          && swipeId == request.resource.data.uid + '_' + string(request.resource.data.movie_id)
          && request.resource.data.decision in ['like', 'dislike'];

        allow update: if isGroupMember(groupId)
          && request.auth.uid == resource.data.uid
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.movie_id == resource.data.movie_id
          && request.resource.data.created_at == resource.data.created_at
          && request.resource.data.decision in ['like', 'dislike'];

        allow delete: if false;
      }

      // Gruppen-Matches (Filme, die alle aktuellen Mitglieder geliked haben).
      // Dokument-ID ist deterministisch die movieId - ein Film kann in einer
      // Gruppe strukturell nie doppelt als Match entstehen. WICHTIG: ob ein
      // Match entsteht, hängt von der aktuellen Mitgliederzahl UND allen
      // Swipes ab - das kann eine Security Rule (kein `for`/Aggregation über
      // eine beliebig lange Members-Collection) nicht sicher selbst prüfen.
      // Deshalb erzeugt ausschließlich die serverseitige Cloud Function
      // `functions/index.js` (Admin-SDK, umgeht Rules) Match-Dokumente; aus
      // dem Client heraus ist jeglicher Schreibzugriff kategorisch verboten.
      match /matches/{matchId} {
        allow read: if isGroupMember(groupId);
        allow write: if false;
      }

      // Gruppenchat. Firestore Auto-ID, chronologisch über den
      // serverseitigen `created_at`-Timestamp sortierbar - die lokale
      // Gerätezeit ist keine vertrauenswürdige Quelle, daher muss
      // `created_at` exakt `request.time` sein (nur von
      // `FieldValue.serverTimestamp()` erfüllbar). Nachrichten sind in
      // dieser ersten Version unveränderlich (kein Bearbeiten/Löschen durch
      // normale Mitglieder) - eine spätere Erweiterung ist ein eigener
      // Entwicklungsschritt. `hasOnly` verhindert zusätzliche, nicht
      // vorgesehene Felder (z. B. eine untergeschobene Sender-Kopie).
      match /messages/{messageId} {
        allow read: if isGroupMember(groupId);

        allow create: if isGroupMember(groupId)
          && request.auth.uid == request.resource.data.sender_uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.created_at == request.time
          && request.resource.data.keys().hasOnly(['sender_uid', 'text', 'created_at']);

        allow update: if false;
        allow delete: if false;
      }
    }

    // Offene Gruppeneinladungen. Dokument-ID ist deterministisch
    // "{groupId}_{inviteeUid}" - verhindert doppelte Einladungen an dieselbe
    // Person für dieselbe Gruppe strukturell. Nur der Admin der Gruppe darf
    // einladen, und ausschließlich echte Freunde (siehe friendships oben) -
    // keine beliebigen UIDs.
    match /group_invitations/{invitationId} {
      allow read: if isSignedIn() &&
        (request.auth.uid == resource.data.inviterUid || request.auth.uid == resource.data.inviteeUid);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.inviterUid
        && request.resource.data.inviterUid != request.resource.data.inviteeUid
        && invitationId == request.resource.data.groupId + '_' + request.resource.data.inviteeUid
        && isGroupAdmin(request.resource.data.groupId)
        && exists(/databases/$(database)/documents/friendships/$(pairId(request.auth.uid, request.resource.data.inviteeUid)))
        && !exists(/databases/$(database)/documents/groups/$(request.resource.data.groupId)/members/$(request.resource.data.inviteeUid));

      allow update: if false;

      allow delete: if isSignedIn() &&
        (request.auth.uid == resource.data.inviterUid
          || request.auth.uid == resource.data.inviteeUid
          || isGroupAdmin(resource.data.groupId));
    }
  }
}
